# Dependencies (ignores top-level, client/node_modules, server/node_modules)
node_modules/
**/node_modules/

# Environment variables & secrets (CRITICAL for security)
.env
.env.*
!.env.example
*.env

# Build & Output files
dist/
client/dist/
build/
client/build/

# Server Uploads / Temp files
server/uploads/*
!server/uploads/.gitkeep

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Editor & OS files
.DS_Store
Thumbs.db
.vscode/
.idea/